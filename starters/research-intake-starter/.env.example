PORT=8080

# Google Sheets destination
SPREADSHEET_ID=replace-with-spreadsheet-id
RESPONSES_SHEET_ID=0

# Optional for local development only.
# On Cloud Run, the runtime service account can obtain a token from metadata.
GOOGLE_ACCESS_TOKEN=

# Comma-separated browser origins allowed to POST to the API.
ALLOWED_ORIGINS=http://localhost:8080

# Optional record prefix
RECORD_PREFIX=RES
